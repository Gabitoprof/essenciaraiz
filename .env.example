# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Sem estas variáveis, o site roda em MODO DEMONSTRAÇÃO.
#
# Só coloque aqui valores PÚBLICOS: tudo que começa com VITE_ vai para o código do navegador.
# NUNCA use a chave service_role (ou qualquer chave secreta) neste arquivo.
VITE_SUPABASE_URL=
# Chave pública: "anon" (projetos antigos) ou "publishable" (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=
